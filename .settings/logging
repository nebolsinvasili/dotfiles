# ------------------------------------------------------------
# Цвета и стили ANSI через tput
# ------------------------------------------------------------
if command -v tput >/dev/null 2>&1 && [ "$(tput colors)" -ge 8 ]; then
    C_RED="$(tput setaf 1)"
    C_GREEN="$(tput setaf 2)"
    C_YELLOW="$(tput setaf 3)"
    C_BLUE="$(tput setaf 4)"
    C_MAGENTA="$(tput setaf 5)"
    C_CYAN="$(tput setaf 6)"
    C_WHITE="$(tput setaf 7)"
    C_BOLD="$(tput bold)"
    C_RESET="$(tput sgr0)"
else
    C_RED=""
    C_GREEN=""
    C_YELLOW=""
    C_BLUE=""
    C_MAGENTA=""
    C_CYAN=""
    C_WHITE=""
    C_BOLD=""
    C_RESET=""
fi

# ------------------------------------------------------------
# Цветовые алиасы
# ------------------------------------------------------------
CLR_ERROR="${C_BOLD}${C_RED}"
CLR_WARN="${C_BOLD}${C_YELLOW}"
CLR_INFO="${C_CYAN}"
CLR_OK="${C_BOLD}${C_GREEN}"
CLR_TITLE="${C_BOLD}${C_MAGENTA}"
CLR_RESET="${C_RESET}"

# ------------------------------------------------------------
# Иконки консоль / файл
# ------------------------------------------------------------
ICONS_ENABLED=1
[ "${TERM:-}" = "dumb" ] && ICONS_ENABLED=0

if [ "$ICONS_ENABLED" -eq 1 ]; then
    ICON_CONS_INFO="ℹ"
    ICON_CONS_OK="✔"
    ICON_CONS_WARN="⚠"
    ICON_CONS_ERROR="✖"
else
    ICON_CONS_INFO="[i]"
    ICON_CONS_OK="[+]"
    ICON_CONS_WARN="[!]"
    ICON_CONS_ERROR="[x]"
fi

ICON_FILE_INFO="[INFO]"
ICON_FILE_OK="[OK]"
ICON_FILE_WARN="[WARN]"
ICON_FILE_ERROR="[ERROR]"

# ------------------------------------------------------------
# Инициализация лог-файла
# ------------------------------------------------------------
# Аргумент: $1 - путь к файлу лога
log_init() {
    if [ -n "${LOG_INITIALIZED:-}" ]; then
        return
    fi

    if [ $# -ne 1 ]; then
        printf 'FATAL: log_init requires log file path\n' >&2
        exit 1
    fi

    local log_path="$1"
    log_path="$(cd "$(dirname "$log_path")" && pwd)/$(basename "$log_path")"
    mkdir -p "$(dirname "$log_path")" || {
        printf 'FATAL: cannot create log directory\n' >&2
        exit 1
    }

    [ -f "$log_path" ] && mv -f "$log_path" "$log_path.old"
    touch "$log_path" || {
        printf 'FATAL: cannot create log file: %s\n' "$log_path" >&2
        exit 1
    }

    LOG_FILE="$log_path"
    readonly LOG_FILE
    readonly LOG_INITIALIZED=1
}

# ------------------------------------------------------------
# Внутренняя функция логирования
# ------------------------------------------------------------
# Аргументы:
#   $1 - цвет консоли
#   $2 - иконка консоли
#   $3 - иконка файла
#   $4..$n - сообщение
_log() {
    local color="$1"
    local icon_console="$2"
    local icon_file="$3"
    shift 3
    local msg="$*"
    local verbose="${VERBOSE_OVERRIDE:-0}"

    # Консоль (только verbose=1)
    if [ "$verbose" -eq 1 ]; then
        printf "%b%s %s%b\n" "$color" "$icon_console" "$msg" "$CLR_RESET"
    fi

    # Файл
    if [ -n "${LOG_FILE:-}" ]; then
        local timestamp
        timestamp="$(date '+%Y-%m-%d %H:%M:%S')"
        echo "[$timestamp] $icon_file $msg" >>"$LOG_FILE"
    fi
}

# ------------------------------------------------------------
# Универсальные функции логирования
# ------------------------------------------------------------
log_error() { VERBOSE_OVERRIDE=0; case "$1" in -v|--verbose) VERBOSE_OVERRIDE=1; shift;; esac; _log "$CLR_ERROR" "$ICON_CONS_ERROR" "$ICON_FILE_ERROR" "$*"; }
log_warn()  { VERBOSE_OVERRIDE=0; case "$1" in -v|--verbose) VERBOSE_OVERRIDE=1; shift;; esac; _log "$CLR_WARN"  "$ICON_CONS_WARN"  "$ICON_FILE_WARN"  "$*"; }
log_info()  { VERBOSE_OVERRIDE=0; case "$1" in -v|--verbose) VERBOSE_OVERRIDE=1; shift;; esac; _log "$CLR_INFO"  "$ICON_CONS_INFO"  "$ICON_FILE_INFO"  "$*"; }
log_ok()    { VERBOSE_OVERRIDE=0; case "$1" in -v|--verbose) VERBOSE_OVERRIDE=1; shift;; esac; _log "$CLR_OK"    "$ICON_CONS_OK"    "$ICON_FILE_OK"    "$*"; }

# ------------------------------------------------------------
# Заголовки
# ------------------------------------------------------------
log_title() {
    printf "%b%s%b\n" "$CLR_TITLE" "$*" "$CLR_RESET"
}
