set -euo pipefail

# ------------------------------------------------------------
# Load modules
# ------------------------------------------------------------
LOGGING_MODULE="$DOTFILES/.settings/logging"
[[ -r "$LOGGING_MODULE" ]] && source "$LOGGING_MODULE" \
    || printf 'WARNING: logging module not found: %s\n' "$LOGGING_MODULE" >&2

LINKED_MODULE="$DOTFILES/.settings/linked"
[[ -r "$LINKED_MODULE" ]] && source "$LINKED_MODULE" \
    || printf 'WARNING: linked module not found: %s\n' "$LINKED_MODULE" >&2

GIT_MODULE="$DOTFILES/.settings/git-utils"
[[ -r "$GIT_MODULE" ]] && source "$GIT_MODULE" \
    || printf 'WARNING: git utils module not found: %s\n' "$GIT_MODULE" >&2

REPLACE_MODULE="$DOTFILES/.settings/replace"
[[ -r "$REPLACE_MODULE" ]] && source "$REPLACE_MODULE" \
    || printf 'WARNING: replace module not found: %s\n' "$REPLACE_MODULE" >&2


# ------------------------------------------------------------
# Absolute script path
# ------------------------------------------------------------
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Default values
DEPENDENCIES_FILE=""
DEP_LOG_FILE=""
PACKAGE_MANAGER="pacman"
ONLY_BLOCKS=""
SKIP_BLOCKS=""
SUDO_CMD=""

# ============================================================
# Show help
# ============================================================
show_help() {
cat <<EOF
Usage: $0 [options]

Options:
  -d <file>           Path to dependencies TOML file
  -l <file>           Log file
  -m <manager>        Package manager (pacman, yay, apt, dnf, zypper)
  --only a,b,c        Install only specified blocks
  --skip a,b,c        Skip specified blocks
  -h, --help          Show this help
EOF
}

# ============================================================
# Parse CLI arguments
# ============================================================
parse_args() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -d|--deps) DEPENDENCIES_FILE="$2"; shift 2 ;;
            -l|--log) DEP_LOG_FILE="$2"; shift 2 ;;
            -m) PACKAGE_MANAGER="$2"; shift 2 ;;
            --only) ONLY_BLOCKS="$2"; shift 2 ;;
            --skip) SKIP_BLOCKS="$2"; shift 2 ;;
            -h|--help) show_help; exit 0 ;;
            *) log_error "Unknown option $1"; show_help; exit 1 ;;
        esac
    done

    if [[ -z "$DEPENDENCIES_FILE" || ! -r "$DEPENDENCIES_FILE" ]]; then
        log_error "Dependencies file not readable: $DEPENDENCIES_FILE"
        exit 1
    fi

    if [[ -z "$DEP_LOG_FILE" ]]; then
        log_error "Log file must be specified (-l)"
        exit 1
    fi

    # Инициализация лог-файла
    log_init "$DEP_LOG_FILE"
}

# ============================================================
# Detect package manager
# ============================================================
detect_package_manager() {
    if [[ -n "$PACKAGE_MANAGER" ]]; then
        PKG_MANAGER="$PACKAGE_MANAGER"
    else
        if command -v pacman >/dev/null 2>&1; then PKG_MANAGER="pacman"
        elif command -v yay >/dev/null 2>&1; then PKG_MANAGER="yay"
        elif command -v apt-get >/dev/null 2>&1; then PKG_MANAGER="apt"
        elif command -v dnf >/dev/null 2>&1; then PKG_MANAGER="dnf"
        elif command -v zypper >/dev/null 2>&1; then PKG_MANAGER="zypper"
        else log_error "No supported package manager found!"; exit 1
        fi
    fi
    log_info -v "Using package manager: $PKG_MANAGER"
}

# ============================================================
# Prepare sudo
# ============================================================
prepare_sudo() {
    if [ "$PKG_MANAGER" = "yay" ] || [ "$EUID" -eq 0 ]; then
        SUDO_CMD=""
    elif command -v sudo >/dev/null 2>&1; then
        SUDO_CMD="sudo"
    else
        log_error "Root privileges required, but sudo not available"
        exit 1
    fi
}

# ============================================================
# Update package database
# ============================================================
update_package_db() {
    log_title "Updating package database..."
    case "$PKG_MANAGER" in
        pacman) $SUDO_CMD pacman -Sy --noconfirm ;;
        yay) yay -Sy --noconfirm ;;
        apt) $SUDO_CMD apt-get update -y ;;
        dnf) $SUDO_CMD dnf check-update -y || true ;;
        zypper) $SUDO_CMD zypper refresh ;;
        *) log_warn -v "Unknown package manager, skipping update" ;;
    esac
    log_ok -v "Package database updated"
}

# ============================================================
# Should process block
# ============================================================
should_process_block() {
    local block="$1"
    if [[ -n "$ONLY_BLOCKS" ]]; then
        echo "$ONLY_BLOCKS" | tr ',' '\n' | grep -qx "$block" || return 1
    fi
    if [[ -n "$SKIP_BLOCKS" ]]; then
        echo "$SKIP_BLOCKS" | tr ',' '\n' | grep -qx "$block" && return 1
    fi
    return 0
}

# ============================================================
# Install packages for a block
# ============================================================
install_block_packages() {
    local block="$1"
    local packages="$2"
    local failed=""
    local retry=""

    for pkg in $packages; do
        log_info -v "Installing $pkg ..."
        case "$PKG_MANAGER" in
            pacman) $SUDO_CMD pacman -S --noconfirm --needed "$pkg" || failed="$failed $pkg" ;;
            apt) $SUDO_CMD apt-get install -y "$pkg" || failed="$failed $pkg" ;;
            dnf) $SUDO_CMD dnf install -y "$pkg" || failed="$failed $pkg" ;;
            zypper) $SUDO_CMD zypper install -y "$pkg" || failed="$failed $pkg" ;;
            yay) yay -S --noconfirm --needed "$pkg" || failed="$failed $pkg" ;;
        esac
    done

    if [[ -n "$failed" ]]; then
        log_warn -v "Retrying failed packages:$failed"
        for pkg in $failed; do
            case "$PKG_MANAGER" in
                pacman) $SUDO_CMD pacman -S --noconfirm --needed "$pkg" || retry="$retry $pkg" ;;
                apt) $SUDO_CMD apt-get install -y "$pkg" || retry="$retry $pkg" ;;
                dnf) $SUDO_CMD dnf install -y "$pkg" || retry="$retry $pkg" ;;
                zypper) $SUDO_CMD zypper install -y "$pkg" || retry="$retry $pkg" ;;
                yay) yay -S --noconfirm --needed "$pkg" || retry="$retry $pkg" ;;
            esac
        done
    fi

    if [[ -n "$retry" ]]; then
        log_error -v "These packages failed after retry: $retry"
        echo "[$(date '+%Y-%m-%d %H:%M:%S')] Block: $block -> $retry" >> missing_apps.txt
    else
        log_ok -v "All packages in block '$block' installed successfully"
    fi
}

# ============================================================
# Parse TOML dependencies (inline + multiline + nested tables)
# ============================================================

parse_toml_dependencies() {
    local current_block=""
    local enabled="true"
    local packages=""
    local in_array=0

    while IFS= read -r line || [ -n "$line" ]; do
        # 1. Удаляем комментарии после #
        line="${line%%#*}"

        # 2. Убираем пробелы в начале и конце
        line="${line#"${line%%[![:space:]]*}"}"
        line="${line%"${line##*[![:space:]]}"}"

        # Пропускаем пустые строки
        [ -z "$line" ] && continue

        # 3. Новый блок [block] или [parent.child]
        if [[ "$line" =~ ^\[([a-zA-Z0-9_.-]+)\]$ ]]; then
            current_block="${BASH_REMATCH[1]}"
            enabled="true"
            packages=""
            in_array=0
            continue
        fi

        # 4. enabled = true/false
        if [[ "$line" =~ ^enabled[[:space:]]*=[[:space:]]*(true|false) ]]; then
            enabled="${BASH_REMATCH[1]}"
            continue
        fi

        # 5. Inline массив на одной строке [ ... ]
        if [[ "$line" =~ ^packages[[:space:]]*=[[:space:]]*\[.*\] ]]; then
            # Извлекаем содержимое между [ и ]
            local items="${line#*\[}"
            items="${items%\]*}"
            packages=""
            # Разделяем по запятым
            IFS=',' read -ra arr <<< "$items"
            for pkg in "${arr[@]}"; do
                pkg="$(echo "$pkg" | sed 's/^ *//;s/ *$//;s/^"\(.*\)"$/\1/')"
                [ -n "$pkg" ] && packages="$packages $pkg"
            done

            # Устанавливаем блок, если включен
            if [[ "$enabled" = "true" && $(should_process_block "$current_block"; echo $?) -eq 0 ]]; then
                install_block_packages "$current_block" "$packages"
            else
                log_warn -v "Skipping block: $current_block"
            fi
            packages=""
            continue
        fi

        # 6. Начало многострочного массива
        if [[ "$line" =~ ^packages[[:space:]]*=[[:space:]]*\[ ]]; then
            in_array=1
            packages=""
            continue
        fi

        # 7. Чтение многострочного массива
        if [[ "$in_array" -eq 1 ]]; then
            # Проверка закрывающей скобки
            if [[ "$line" =~ \] ]]; then
                in_array=0
                line="${line%\]*}"  # удаляем ]
            fi

            # Убираем комментарии
            line="${line%%#*}"

            # Разделяем по запятой
            IFS=',' read -ra arr <<< "$line"
            for pkg in "${arr[@]}"; do
                pkg="$(echo "$pkg" | sed 's/^ *//;s/ *$//;s/^"\(.*\)"$/\1/')"
                [ -n "$pkg" ] && packages="$packages $pkg"
            done

            # Если массив закончился
            if [[ "$in_array" -eq 0 ]]; then
                if [[ "$enabled" = "true" && $(should_process_block "$current_block"; echo $?) -eq 0 ]]; then
                    install_block_packages "$current_block" "$packages"
                else
                    log_warn -v "Skipping block: $current_block"
                fi
                packages=""
            fi
        fi
    done < "$DEPENDENCIES_FILE"
}


# ============================================================
# Main entry
# ============================================================
install_dependencies() {
    log_title "Installing dependencies from TOML file..."
    parse_args "$@"
    detect_package_manager
    prepare_sudo
    update_package_db
    parse_toml_dependencies
}
