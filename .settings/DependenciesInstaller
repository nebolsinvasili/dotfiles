# Absolute path of running script
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"

DOTFILES_DIR="/home/nebolsinvasili/dotfiles-act"

# Load TOML parser
PARSER_DIR="$DOTFILES_DIR/.settings/toml_parser.sh"
if [ -f "$PARSER_DIR" ]; then
  . "$PARSER_DIR"
else
  echo "WARNING: Parser file not found: $PARSER_DIR"
  exit 1
fi

# Load logging functions
LOGGING_DIR="$DOTFILES_DIR/.settings/logging"
if [ -f "$LOGGING_DIR" ]; then
  . "$LOGGING_DIR"
else
  echo "WARNING: Logging file not found: $LOGGING_DIR"
  exit 1
fi

# Default values
DEPENDENCIES_FILE="$SCRIPT_DIR/dependencies.toml"
ONLY_BLOCKS=""
SKIP_BLOCKS=""
PACKAGE_MANAGER=""
SUDO_CMD=""

# ===========================
# Function: show_help
# Purpose : Display script usage instructions
# ===========================
show_help() {
  cat <<EOF
Usage: $0 [options]

Options:
  -d <file>       Path to the dependencies TOML file (default: $DEPENDENCIES_FILE)
  -m <manager>    Package manager to use (pacman, yay, apt, dnf, zypper)
  -h, --help      Show this help message and exit
  --only a,b,c     Install only specified blocks
  --skip a,b,c     Skip specified blocks

Examples:
  $0 -d ./deps.toml
  $0 -m yay
EOF
}

# ===========================
# Function: parse_args
# Purpose : Parse command line arguments for dependency file and package manager
# ===========================
parse_args() {
  while [[ $# -gt 0 ]]; do
    case $1 in
    -d)
      if [[ -n $2 && $2 != -* ]]; then
        DEPENDENCIES_FILE="$2"
        shift 2
      else
        log_error "Option -d requires an argument."
        show_help
        exit 1
      fi
      ;;
    -m)
      if [[ -n $2 && $2 != -* ]]; then
        PACKAGE_MANAGER="$2"
        shift 2
      else
        log_error "Option -m requires an argument."
        show_help
        exit 1
      fi
      ;;
    -h | --help)
      show_help
      exit 0
      ;;
    --only)
      ONLY_BLOCKS="$2"
      shift 2
      ;;
    --skip)
      SKIP_BLOCKS="$2"
      shift 2
      ;;
    *)
      log_error "Unknown option: $1"
      show_help
      exit 1
      ;;
    esac
  done

  # Validate dependency file
  if [ ! -f "$DEPENDENCIES_FILE" ]; then
    log_error "Dependencies file not found: $DEPENDENCIES_FILE"
    exit 1
  fi
}

# ============================================================
# Function: prepare_sudo
# Purpose : Relaunch script via sudo if required
# ============================================================
prepare_sudo() {
  # yay не требует root
  if [ "$PKG_MANAGER" = "yay" ]; then
    SUDO_CMD=""
    return
  fi

  # Если уже root — sudo не нужен
  if [ "$EUID" -eq 0 ]; then
    SUDO_CMD=""
    return
  fi

  if command -v sudo >/dev/null 2>&1; then
    SUDO_CMD="sudo"
  else
    log_error "This operation requires root privileges, but sudo is not available."
    exit 1
  fi
}

# ===========================
# Function: detect_package_manager
# Purpose : Detects or validates package manager
# ===========================
detect_package_manager() {
  if [ -n "$PACKAGE_MANAGER" ]; then
    PKG_MANAGER="$PACKAGE_MANAGER"
  else
    if command -v pacman >/dev/null 2>&1; then
      PKG_MANAGER="pacman"
    elif command -v yay >/dev/null 2>&1; then
      PKG_MANAGER="yay"
    elif command -v apt-get >/dev/null 2>&1; then
      PKG_MANAGER="apt"
    elif command -v dnf >/dev/null 2>&1; then
      PKG_MANAGER="dnf"
    elif command -v zypper >/dev/null 2>&1; then
      PKG_MANAGER="zypper"
    else
      log_error "No supported package manager found!"
      exit 1
    fi
  fi
  log_info "Using package manager: $PKG_MANAGER"
}

# ===========================
# Function: install_block_packages
# Purpose : Install packages for a single block
# ===========================
install_block_packages() {
  local block="$1"
  local packages="$2"
  local failed_deps=""
  local retry_failed=""

  for pkg in $packages; do
    log_info "Installing $pkg ..."
    case "$PKG_MANAGER" in
    pacman) $SUDO_CMD pacman -S --noconfirm --needed "$pkg" || failed_deps="$failed_deps $pkg" ;;
    apt) $SUDO_CMD apt-get install -y "$pkg" || failed_deps="$failed_deps $pkg" ;;
    dnf) $SUDO_CMD dnf install -y "$pkg" || failed_deps="$failed_deps $pkg" ;;
    zypper) $SUDO_CMD zypper install -y "$pkg" || failed_deps="$failed_deps $pkg" ;;
    yay) yay -S --noconfirm --needed "$pkg" || failed_deps="$failed_deps $pkg" ;;
    esac
  done

  # Retry failed packages
  if [ -n "$failed_deps" ]; then
    log_warn "Retrying failed packages: $failed_deps"
    for pkg in $failed_deps; do
      case "$PKG_MANAGER" in
      pacman) $SUDO_CMD pacman -S --noconfirm --needed "$pkg" || retry_failed="$retry_failed $pkg" ;;
      apt) $SUDO_CMD apt-get install -y "$pkg" || retry_failed="$retry_failed $pkg" ;;
      dnf) $SUDO_CMD dnf install -y "$pkg" || retry_failed="$retry_failed $pkg" ;;
      zypper) $SUDO_CMD zypper install -y "$pkg" || retry_failed="$retry_failed $pkg" ;;
      yay) yay -S --noconfirm --needed "$pkg" || retry_failed="$retry_failed $pkg" ;;
      esac
    done
  fi

  if [ -n "$retry_failed" ]; then
    log_error "These packages in block '$block' failed after retry: $retry_failed"

    timestamp="[$(date '+%Y-%m-%d %H:%M:%S')]"
    printf "%s Block: %s -> %s\n" "$timestamp" "$block" "$retry_failed" >>missing_apps.txt
  else
    log_ok "All packages in block '$block' installed successfully"
  fi
}

# ===========================
# MAIN FUNCTION
# ===========================
install_dependencies() {
  clear
  log_title "Installing dependencies from TOML file..."
  parse_args "$@"
  detect_package_manager
  prepare_sudo "$@"
  parse_toml_dependencies
}
